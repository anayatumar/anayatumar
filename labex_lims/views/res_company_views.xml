<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_lab_inherit" model="ir.ui.view">
        <name>res.company.form.lab.inherit</name>
        <model>res.company</model>
        <inherit_id ref="base.view_company_form"/>
        <arch type="xml">
            <notebook position="inside">
                <page string="Laboratory Info">
                    <group>
                        <field name="lab_tagline"/>
                        <field name="lab_license_no"/>
                    </group>
                </page>
            </notebook>
        </arch>
    </record>
</odoo>
