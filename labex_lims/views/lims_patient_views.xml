<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lims_patient_tree" model="ir.ui.view">
        <name>lims.patient.tree</name>
        <model>lims.patient</model>
        <arch type="xml">
            <tree string="Patients">
                <field name="mr_no"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="contact_no"/>
                <field name="city"/>
            </tree>
        </arch>
    </record>

    <record id="view_lims_patient_form" model="ir.ui.view">
        <name>lims.patient.form</name>
        <model>lims.patient</model>
        <arch type="xml">
            <form string="Patient">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="mr_no" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="guardian_name"/>
                            <field name="gender"/>
                            <field name="dob"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="contact_no"/>
                            <field name="email"/>
                            <field name="city"/>
                            <field name="referred_by"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </arch>
    </record>

    <record id="action_lims_patient" model="ir.actions.act_window">
        <name>Patients</name>
        <res_model>lims.patient</res_model>
        <view_mode>tree,form</view_mode>
    </record>

    <menuitem id="menu_lims_patient"
              name="Patients"
              parent="menu_lims_operations"
              action="action_lims_patient"
              sequence="5"/>
</odoo>
