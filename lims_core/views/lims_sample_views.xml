<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lims_sample_tree" model="ir.ui.view">
        <name>lims.sample.tree</name>
        <model>lims.sample</model>
        <arch type="xml">
            <tree string="Samples" decoration-info="state == 'draft'" decoration-warning="priority == '1'" decoration-danger="priority == '2'">
                <field name="name"/>
                <field name="patient_name"/>
                <field name="sample_type"/>
                <field name="collection_date"/>
                <field name="priority"/>
                <field name="state"/>
            </tree>
        </arch>
    </record>

    <record id="view_lims_sample_form" model="ir.ui.view">
        <name>lims.sample.form</name>
        <model>lims.sample</model>
        <arch type="xml">
            <form string="Sample">
                <header>
                    <button name="action_receive" string="Receive" type="object" states="draft" class="oe_highlight"/>
                    <button name="action_test" string="Start Testing" type="object" states="received" class="oe_highlight"/>
                    <button name="action_validate" string="Validate" type="object" states="testing" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,testing,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_name"/>
                            <field name="sample_type"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="collection_date"/>
                            <field name="received_date" states="received,testing,validated"/>
                            <field name="external_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tests" name="tests">
                            <field name="test_ids">
                                <tree editable="bottom">
                                    <field name="test_id"/>
                                    <field name="result"/>
                                    <field name="unit_id"/>
                                    <field name="reference_range"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </arch>
    </record>

    <record id="action_lims_sample" model="ir.actions.act_window">
        <name>Samples</name>
        <res_model>lims.sample</res_model>
        <view_mode>tree,form</view_mode>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first laboratory sample!
            </p>
        </help>
    </record>

    <menuitem id="menu_lims_sample"
              name="Samples"
              parent="menu_lims_operations"
              action="action_lims_sample"
              sequence="10"/>
</odoo>
