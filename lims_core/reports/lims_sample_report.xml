<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_lims_sample" model="ir.actions.report">
        <name>Laboratory Report</name>
        <model>lims.sample</model>
        <report_type>qweb-pdf</report_type>
        <report_name>lims_core.report_lims_sample_template</report_name>
        <report_file>lims_core.report_lims_sample_template</report_file>
        <print_report_name>'LabReport_%s' % (object.name)</print_report_name>
        <binding_model_id ref="model_lims_sample"/>
        <binding_type>report</binding_type>
    </record>

    <template id="report_lims_sample_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row">
                            <div class="col-6">
                                <h3>Laboratory Report</h3>
                                <strong>Lab ID: </strong> <span t-field="o.name"/><br/>
                                <strong>MR No: </strong> <span t-field="o.patient_id.mr_no"/><br/>
                                <strong>External ID: </strong> <span t-field="o.external_id"/><br/>
                            </div>
                            <div class="col-6 text-right">
                                <strong>Patient Name: </strong> <span t-field="o.patient_id.name"/><br/>
                                <strong>Age/Gender: </strong> <span t-field="o.patient_id.age"/> / <span t-field="o.patient_id.gender"/><br/>
                                <strong>Refered By: </strong> <span t-field="o.patient_id.referred_by"/><br/>
                                <strong>Date: </strong> <span t-field="o.received_date" t-options='{"widget": "date"}'/><br/>
                            </div>
                        </div>

                        <br/><br/>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Test Name</th>
                                    <th>Result</th>
                                    <th>Unit</th>
                                    <th>Reference Range</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.test_ids" t-as="line">
                                    <td><span t-field="line.test_id.name"/></td>
                                    <td><strong><span t-field="line.result"/></strong></td>
                                    <td><span t-field="line.unit_id.name"/></td>
                                    <td><span t-field="line.reference_range"/></td>
                                    <td><span t-field="line.state"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt32">
                            <div class="col-12">
                                <p><strong>Note:</strong> This is a computer generated report and does not require a physical signature.</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
